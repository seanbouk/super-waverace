# PVSnesLib build artifacts
game/*.sfc
game/*.log
game/*.sym
game/*.symfull
game/linkfile
# game/hdr.asm is hand-maintained now (AUTOHDR=0): the IRQ vector points
# at the scanline mode-switch handler
game/*.obj
game/src/*.obj
game/src/*.ps
game/src/*.asm

# generated by tools/bake_tables.py + gfx4snes
game/bake.stamp
game/sea.png
game/sea*.png
game/sea.pc7
game/sea.mp7
game/sea.pal
game/sea.inc
game/wavetables.asm
game/wavedata.c
game/wavedata.h

# ROM copied into the web player for local testing
web/superwaverace.sfc

# local toolchain (never commit; see README for install)
toolchain/
game/*.as
__pycache__/
game/ski.png

# generated by smconv (SNESMod soundbank, from assets/music/*.it)
game/soundbank.asm
game/soundbank.h
game/soundbank.bnk

# Suno stems/zips are LOCAL ONLY (hundreds of MB; GitHub rejects >100MB)
# - only derived artifacts (MIDI, .it) are committed
assets/music/*/*.wav
assets/music/*/*.zip
assets/music/*/*.mp3
# but DO commit the baked sampled-instrument kit (small, CI needs it -
# the 148MB .sf2 it came from is local-only)
!assets/music/kit/*.wav

# FluidR3_GM soundfont (148MB, local only - see tools/sf2extract.py)
*.sf2
assets/music/sf2preview/
